/*
========================================================================================
    Shared module options — publishDir for outputs used across all workflows
========================================================================================
*/

process {

    // publishDir for pmultiqc reports
    withName: 'BIGBIO_QUANTMSDIANN:QUANTMSDIANN:SUMMARY_PIPELINE' {
        // pmultiqc's memory scales with the DIA-NN report: on PXD030304 (5,798
        // runs, 26.5 GiB parquet) it peaks at 70.7 GiB against the flat 72 GB
        // that the module's process_high label gives (bigbio/pmultiqc#717), so
        // a larger experiment is OOM-killed on the first attempt.
        //
        // The report's size cannot be consulted here. A withName: closure is
        // resolved against the config and params, NOT against the process's
        // input variables, so naming a staged input yields an undefined
        // ConfigObject rather than a Path. Scale on retry instead, which is
        // what actually recovers an OOM.
        memory        = { 72.GB * task.attempt }
        // The vendored module has no error_retry label, so a single OOM ended
        // the whole run. 137 is SIGKILL (the OOM killer), 140 is the SLURM
        // out-of-memory signal.
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'finish' }
        maxRetries    = 2
        // pmultiqc/MultiQC flags. Previously hard-coded inside the local pmultiqc
        // module; now passed via ext.args to the shared bigbio/pmultiqc module.
        ext.args = {
            // Plain java.io.File, not file(): the Nextflow file() helper is not
            // bound in a process config closure. A remote or unreadable input
            // simply leaves the count at 0, which keeps the tables enabled.
            def sdrf_runs = 0
            try {
                def sdrf_file = new File(params.input.toString())
                if (sdrf_file.exists()) {
                    sdrf_runs = sdrf_file.readLines().count { it?.trim() } - 1
                }
            }
            catch (Exception e) {
                sdrf_runs = 0
            }
            [
                params.enable_pmultiqc ? '--quantms-plugin' : '',
                // Tables off when asked, or when the experiment is large: pmultiqc's
                // peptide/protein tables re-read the MSstats input (20.6 GiB, 231 M rows
                // on PXD030304 -> 93 GB in pandas) for a table that makes no sense at
                // hundreds of samples. Runs are counted from the SDRF in params.input
                // (one data row per run) because that is reachable from config; the
                // staged design file is not. Any failure to read it leaves tables on.
                (params.enable_pmultiqc && (params.skip_table_plots || sdrf_runs > (params.pmultiqc_table_max_runs ?: 500))) ? '--disable-table' : '',
                (params.enable_pmultiqc && params.pmultiqc_idxml_skip) ? '--ignored-idxml' : '',
                params.contaminant_string ? "--contaminant-affix ${params.contaminant_string}" : '',
                '--config ./results/multiqc_config.yml',
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/pmultiqc" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // PRIDEPY_DOWNLOAD — download raw files from PRIDE Archive
    withName: '.*:PRIDEPY_DOWNLOAD' {
        ext.args = {
            "download-all-public-raw-files" +
            " -a ${params.project_accession}" +
            " -p ${params.pridepy_protocol}" +
            " -o ." +
            " -w 3" +
            " --skip-if-downloaded-already --checksum-check" +
            (params.pridepy_protocol == 'aspera' ? " --aspera-maximum-bandwidth ${params.aspera_maximum_bandwidth}" : "")
        }
        publishDir = [
            path: { "${params.outdir}/pridepy" },
            mode: 'link',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // publishDir for SDRF files
    withName: 'BIGBIO_QUANTMSDIANN:QUANTMSDIANN:INPUT_CHECK:SAMPLESHEET_CHECK' {
        publishDir = [
            path: { "${params.outdir}/sdrf" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // publishDir for configurations files from SDRF parsing
    withName: '.*:SDRF_PARSING' {
        publishDir = [
            path: { "${params.outdir}/sdrf" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Result tables from DIA-NN quantification and MSstats format conversion
    withName: '.*:(FINAL_QUANTIFICATION|DIANN_MSSTATS)' {
        publishDir = [
            path: { "${params.outdir}/quant_tables" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Optional: publish TSV spectral library from in-silico generation.
    // Enable via ext.publish_speclib_tsv in a custom config or via --save_speclib_tsv.
    withName: '.*:INSILICO_LIBRARY_GENERATION' {
        publishDir = [
            path: { "${params.outdir}/library_generation" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.endsWith('.tsv') && (task.ext.publish_speclib_tsv || params.save_speclib_tsv)) return filename
                return null
            }
        ]
    }

    // publishDir for all features tables
    withName: '.*:MZML_STATISTICS' {
        publishDir = [
            path: { "${params.outdir}/spectra/mzml_statistics" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // QPX Parquet + MuData export (experimental, 2.1.0)
    // Flatten the layout: the QPX dataset `*.parquet` files (emitted by the
    // module as `qpx_output/*`) and the `*.h5mu` MuData file are published
    // directly under `qpx/`, with no intermediate `qpx_output/` subfolder.
    // `tokenize('/').last()` strips the `qpx_output/` prefix from the dataset
    // files so everything lands flat in `qpx/`.
    withName: '.*:QPX_DIANN' {
        // Feature cutoff for the qpx conversion. It must track the precursor
        // q-value the run was actually analysed at, or the published parquet
        // disagrees with the MSstats/report outputs beside it.
        //
        // `precursor_qvalue` defaults to null and is resolved version-aware
        // (< 2.5 -> 0.01, >= 2.5 -> 0.05). FINAL_QUANTIFICATION and
        // DIANN_MSSTATS call VersionUtils.resolvePrecursorQvalue for this;
        // QPX_DIANN cannot -- it is vendored from bigbio/nf-modules and is
        // deliberately generic, so it falls back to a flat 0.05. On the
        // defaults with DIA-NN < 2.5 that converted at 5% while the run was
        // filtered at 1%.
        //
        // Nextflow config closures cannot see lib/ (verified on 25.10.4 and
        // 26.04: "No such variable: VersionUtils"), so the resolution is
        // inlined here. Keep it in step with VersionUtils.resolvePrecursorQvalue.
        // `--qvalue-threshold` is last-wins in qpxc, so this ext.args overrides
        // the module's own default.
        ext.args = {
            def v = ((params.diann_version?.toString() ?: '1.8.1').tokenize('.').collect { it.isInteger() ? it.toInteger() : 0 } + [0, 0])
            def q = params.precursor_qvalue != null ? params.precursor_qvalue : ((v[0] < 2 || (v[0] == 2 && v[1] < 5)) ? 0.01 : 0.05)
            "--qvalue-threshold ${q}"
        }
        publishDir = [
            path: { "${params.outdir}/qpx" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.tokenize('/').last() }
        ]
    }
}
