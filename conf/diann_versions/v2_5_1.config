/*
 * DIA-NN 2.5.1 container override (private ghcr.io)
 * Academic build of DIA-NN 2.5.1 (the Enterprise build is a separate image,
 * see conf/diann_versions/v2_5_1_enterprise.config and -profile diann_v2_5_1_enterprise).
 */
params.diann_version = '2.5.1'

process {
    withLabel: diann {
        container = 'ghcr.io/bigbio/diann:2.5.1'
    }
}

// Container engine is selected via -profile (docker/singularity), not here
