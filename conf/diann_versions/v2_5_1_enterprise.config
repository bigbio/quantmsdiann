/*
 * DIA-NN 2.5.1 Enterprise container override (private ghcr.io)
 *
 * Enterprise is a separate image from the academic build
 * (academic 2.5.1, if shipped, is `ghcr.io/bigbio/diann:2.5.1`).
 * The image bundles the Enterprise binary + the Knowledge Base model
 * (models/base232.nnkb) but NO license key — supply the key at runtime
 * with `--diann_license <file>` (or bake it next to the binary in a strictly
 * private local build). The license key must never be committed or pushed.
 *
 * Enterprise adds the `--kb` Knowledge Base option (enable with `--enable_kb`),
 * which boosts identifications, primarily on human data.
 */
params.diann_version    = '2.5.1'
params.diann_enterprise = true
// Knowledge Base is the headline Enterprise feature, so it's on by default for
// this profile. Disable per-run with `--enable_kb false`.
params.enable_kb        = true

process {
    withLabel: diann {
        container = 'ghcr.io/bigbio/diann-enterprise:2.5.1'
    }
}

// Container engine is selected via -profile (docker/singularity), not here
